{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier' : 'Créer' }} une chasse - Booty QR{% endblock %}

{% block page_name %}{{ is_edit ? 'Modifier la chasse' : 'Nouvelle chasse' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/hunt-form.css') }}">
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.title) }}
                            {{ form_widget(form.title) }}
                            {{ form_errors(form.title) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.mode) }}
                            <div class="radio-group">
                                {% for choice in form.mode %}
                                    <div class="form-check">
                                        {{ form_widget(choice) }}
                                        {{ form_label(choice) }}
                                    </div>
                                {% endfor %}
                            </div>
                            {{ form_errors(form.mode) }}
                        </div>

                        <div class="mb-4" id="questionSettingsBlock" style="display: none;">
                            <h5>Paramètres des questions</h5>
                            
                            <div class="mb-4">
                                {{ form_label(form.hasTimeLimit) }}
                                <div class="radio-group">
                                    {% for choice in form.hasTimeLimit %}
                                        <div class="form-check">
                                            {{ form_widget(choice) }}
                                            {{ form_label(choice) }}
                                        </div>
                                    {% endfor %}
                                </div>
                                {{ form_errors(form.hasTimeLimit) }}
                            </div>

                            <div id="timeLimitFields" style="display: none;">
                                <div class="mb-4">
                                    <label>Durée pour répondre</label>
                                    <div class="time-picker-wrapper">
                                        <div class="time-input-group">
                                            {{ form_widget(form.timeLimitMinutes) }}
                                            <span class="time-label">min</span>
                                        </div>
                                        <span class="time-separator">:</span>
                                        <div class="time-input-group">
                                            {{ form_widget(form.timeLimitSeconds) }}
                                            <span class="time-label">sec</span>
                                        </div>
                                    </div>
                                    <small class="form-text text-muted">Entre 0 et 5 minutes maximum</small>
                                </div>

                                <div class="mb-3">
                                    {{ form_label(form.timeLimitMode) }}
                                    <div class="radio-group">
                                        {% for choice in form.timeLimitMode %}
                                            <div class="form-check">
                                                {{ form_widget(choice) }}
                                                {{ form_label(choice) }}
                                            </div>
                                        {% endfor %}
                                    </div>
                                    {{ form_errors(form.timeLimitMode) }}
                                </div>
                            </div>
                        </div>

                        {% if not is_edit %}
                            <div class="mb-3">
                                {{ form_label(form.qrCodeCount) }}
                                {{ form_widget(form.qrCodeCount) }}
                                {{ form_errors(form.qrCodeCount) }}
                                {{ form_help(form.qrCodeCount) }}
                            </div>
                        {% endif %}

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                {{ is_edit ? 'Enregistrer les modifications' : 'Créer la chasse' }}
                            </button>
                            <a href="{{ path('hunt_index') }}" class="btn btn-secondary">Annuler</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/hunt-form.js') }}"></script>
{% endblock %}
